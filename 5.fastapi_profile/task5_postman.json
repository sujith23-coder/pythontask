{
  "info": {
    "name": "Task 5 - User Profile API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "profile_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secretpass123\",\n  \"bio\": \"I love coding!\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Get token (OAuth2 form)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "john_doe" },
                { "key": "password", "value": "secretpass123" }
              ]
            },
            "url": "{{base_url}}/auth/token"
          }
        }
      ]
    },
    {
      "name": "Profiles",
      "item": [
        {
          "name": "Create profile (JWT)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jane_doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"anotherpass123\",\n  \"bio\": \"Second user\"\n}"
            },
            "url": "{{base_url}}/profiles/"
          }
        },
        {
          "name": "Me",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/profiles/me"
          }
        },
        {
          "name": "Get by id",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/profiles/{{profile_id}}"
          }
        },
        {
          "name": "Update (owner)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Updated bio text\"\n}"
            },
            "url": "{{base_url}}/profiles/{{profile_id}}"
          }
        },
        {
          "name": "Delete (owner)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{base_url}}/profiles/{{profile_id}}"
          }
        },
        {
          "name": "Error - duplicate email on register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"other\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secretpass123\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Error - no JWT on GET profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/profiles/1"
          }
        }
      ]
    }
  ]
}
